{
  "name": "@mulla/nodejs",
  "version": "0.1.2",
  "description": "Official Node.js library for the Mulla payment gateway: MTN Mobile Money and Airtel Money (Rwanda).",
  "keywords": [
    "mulla",
    "payments",
    "mobile money",
    "momo",
    "mtn",
    "airtel",
    "rwanda",
    "webhooks",
    "sdk",
    "kayko"
  ],
  "homepage": "https://github.com/kaykorw/mulla-node-sdk#readme",
  "bugs": "https://github.com/kaykorw/mulla-node-sdk/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kaykorw/mulla-node-sdk.git"
  },
  "license": "MIT",
  "author": "Kayko",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./testing": {
      "import": {
        "types": "./dist/testing.d.ts",
        "default": "./dist/testing.js"
      },
      "require": {
        "types": "./dist/testing.d.cts",
        "default": "./dist/testing.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run tests/integration",
    "check:package": "publint && attw --pack . --profile node16",
    "check": "npm run lint && npm run typecheck && npm test && npm run build && npm run check:package",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^10.0.0",
    "@types/node": "^20.19.0",
    "eslint": "^10.0.0",
    "globals": "^17.14.0",
    "prettier": "^3.6.0",
    "publint": "^0.3.25",
    "tsup": "^8.5.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^4.0.0"
  }
}
